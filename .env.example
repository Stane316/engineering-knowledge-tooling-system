# =============================================================================
# EKTS - variables d'environnement (Sprint 4)
# =============================================================================
# Copiez ce fichier en `.env` puis renseignez votre cle :
#   PowerShell : Copy-Item .env.example .env
#
# ATTENTION : `.env` est ignore par git et par Gitleaks. Ne commitez JAMAIS de
# cle reelle, ne la collez pas dans une issue ou un message.
# =============================================================================

# Cle API OpenAI - OBLIGATOIRE pour les embeddings (Sprint 4).
# Sans elle, `npm run test:benchmark` fonctionne (fournisseur local factice)
# mais l'indexation vectorielle reelle echoue avec EmbeddingsError.
OPENAI_API_KEY=

# Modele d'embedding (optionnel). Doit produire 1536 dimensions.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Dimension des vecteurs (optionnel). Doit rester 1536 : le schema SQLite
# `vectors.resources_vectors.embedding` est declare `float[1536]`.
# Toute autre valeur leve une EmbeddingsError explicite.
EMBEDDING_DIMENSION=1536

# Repertoire des bases SQLite (optionnel, defaut : ./data).
# EKTS_DATA_DIR=./data

# Niveau de log pino (optionnel, defaut : info).
# LOG_LEVEL=info
