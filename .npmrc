# Les scripts de cycle de vie npm sont désactivés pour ce dépôt.
#
# Pourquoi : `better-sqlite3` 13 embarque ses binaires précompilés dans le paquet
# (`prebuilds/`), aucune compilation n'est nécessaire. Mais `npm ci` (et `npm install`
# avec un lockfile) ne conserve pas `gypfile: false` : npm voit `binding.gyp`, en déduit
# un module natif et lance `node-gyp rebuild`, qui échoue sans Visual Studio (Windows)
# ou sans chaîne de compilation (Linux/macOS).
#
# Conséquence : `npm ci` réussit partout, sans compilateur ni accès à nodejs.org.
# Les hooks Git s'installent avec `npm run setup` (Husky n'est plus lancé par `prepare`).
#
# Pour réactiver ponctuellement les scripts : `npm ci --ignore-scripts=false`
ignore-scripts=true
