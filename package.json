{
  "name": "ekts",
  "version": "0.2.0",
  "description": "Engineering Knowledge & Tooling System — système personnel d'ingénierie augmenté par l'IA",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run tests/browser",
    "test:benchmark": "npm run build && tsc -p tsconfig.benchmark.json && node dist-benchmark/tests/benchmark/search-benchmark.js",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run coverage",
    "security:secrets": "gitleaks git --pre-commit --staged --redact --config .gitleaks.toml",
    "setup": "husky && node scripts/check-env.mjs",
    "check:env": "node scripts/check-env.mjs",
    "doctor": "node scripts/doctor.mjs",
    "db:inspect": "node scripts/inspect-data-layer.mjs",
    "db:reindex": "node scripts/reindex.mjs",
    "providers": "node scripts/providers.mjs",
    "prepare": "husky",
    "cli": "node dist/cli/index.js",
    "mcp": "node dist/mcp/server.js",
    "test:e2e": "playwright test",
    "test:e2e:mvp3": "vitest run tests/e2e/mvp3/",
    "browsers:install": "playwright install chromium firefox webkit",
    "doctor:browsers": "node scripts/browser-doctor.mjs",
    "inspect": "node scripts/inspect.mjs",
    "audit": "npm audit",
    "audit:prod": "npm audit --omit=dev",
    "audit:ci": "npm audit --audit-level=high",
    "audit:prod:ci": "npm audit --omit=dev --audit-level=high",
    "bench:latency": "node scripts/latency-report.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lighthouse": "^13.5.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "openai": "7.41.0",
    "pino": "^10.4.0",
    "puppeteer": "^25.16.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.6.7"
  },
  "bin": {
    "ekts": "dist/cli/index.js"
  }
}
